# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash

# Authenticated web voice transcription proxy. Keep the API key server-side.
# DEEPGRAM_API_KEY
# DEEPGRAM_MODEL
# DEEPGRAM_LANGUAGE
# DEEPGRAM_BASE_URL
